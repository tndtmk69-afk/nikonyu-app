# このファイルを .env.local にコピーして、値を書いてください。
# .env.local はGitに含まれません。EXPO_PUBLIC_ で始まらない値は秘密なので、人に見せたりチャットに貼ったりしないでください。

# LINEログイン（LINE Developers の「チャネル基本設定」）
EXPO_PUBLIC_LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=

# Supabase（ダッシュボードの Settings > API Keys。URL は Connect ボタンから）
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Gemini（Google AI Studio の「Get API key」）
GEMINI_API_KEY=

# Cloudflare Workers AI（記事のイメージ画像をAIで作る。なくても動き、Wikimedia Commons の写真を使う）
# アカウントID：ダッシュボードの「Account details」。トークン：My Profile > API Tokens で Workers AI の Read と Edit を付けて作る
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
